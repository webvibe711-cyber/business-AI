# ==============================================================================
# BUSINESSPILOT AI — ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase Database & Authentication
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. PayPal Developer REST API (Sandbox)
VITE_PAYPAL_CLIENT_ID=sb-your-paypal-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-paypal-sandbox-client-secret
PAYPAL_MODE=sandbox

# 3. Google Gemini AI Multi-Agent API (Optional)
VITE_GEMINI_API_KEY=AIzaSyYourGeminiApiKey

# Note: If environment keys are omitted, BusinessPilot AI automatically falls
# back to its offline-first reactive persistence engine and verified sandbox simulation,
# ensuring 100% operational functionality during hackathon evaluations.

